{
  "manifest_version": 3,
  "name": "Focus Guard: Code Without the Crutch",
  "version": "1.0.0",
  "description": "Blocks AI chat sites during coding sessions so you solve problems yourself first.",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background/background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Focus Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "web_accessible_resources": [
    { "resources": ["src/blocked/blocked.html", "src/blocked/links.js", "src/blocked/blocked.js", "src/shared/style.css"], "matches": ["<all_urls>"] }
  ]
}
